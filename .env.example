# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/funnel_agent

# ---- Gemini (direct Google GenAI SDK; no LangChain) ----
GEMINI_API_KEY=your-gemini-api-key
# Model used for scoring (Stage B) and the decision engine. Override per env.
GEMINI_MODEL=gemini-2.5-flash

# ---- App ----
SITE_ID=default
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- Going live: browser ingestion + safety ----
# Public write key required on /track & /identify (blank = disabled, dev-friendly).
# Proves a caller is your backend, not a browser. Required to assert facts a
# browser must not be trusted with — today that is phone_verified on /identify
# (your OTP flow). Send it as the X-Server-Key header. Unset = no enforcement.
SERVER_KEY=
TRACK_WRITE_KEY=
# Origins allowed to POST from the browser, comma-separated. In prod use your site,
# e.g. https://engageoagency.com,https://www.engageoagency.com
CORS_ALLOW_ORIGINS=*
# shadow = never actually send (stub + log); live = use real senders once configured.
EXECUTION_MODE=shadow

# ---- Admin auth (HTTP Basic on /dashboard + /score, /decide, /execute) ----
# /track, /identify and /health stay public. REQUIRED on any public deploy:
# if ADMIN_PASSWORD is blank, the dashboard + control routes return 503 (locked).
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---- WhatsApp via Meta Cloud API (only used when EXECUTION_MODE=live) ----
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_API_VERSION=v21.0
# text = only inside the 24h window; template = business-initiated outreach (needs an approved template)
META_WA_MESSAGE_TYPE=text
META_WA_TEMPLATE_NAME=
META_WA_TEMPLATE_LANG=en_US
# set false for zero-variable templates like hello_world
META_WA_TEMPLATE_BODY_PARAM=true

# ---- Autonomous scheduler ----
# Runs score -> decide -> execute on a loop so live traffic becomes scored
# visitors + decisions automatically. Only new/changed leads are processed.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=120

# ---- Deploy (Railway / Docker) ----
# The host injects PORT; the app binds it automatically. Apply schema.sql on
# container start (idempotent); set false if you manage the schema yourself.
RUN_SCHEMA_ON_STARTUP=true

# ---- Inbound WhatsApp webhook (Meta calls US) ----
# Meta app dashboard -> WhatsApp -> Configuration -> Webhook:
#   Callback URL: https://YOUR_APP/webhooks/whatsapp   Subscribe to: messages
# The token you type into Meta's "Verify token" box; echoed back on the GET handshake.
META_WA_VERIFY_TOKEN=
# Meta app secret. Every POST is checked against its X-Hub-Signature-256 HMAC.
# Unset => the webhook returns 503 rather than trusting an unauthenticated public URL.
META_WA_APP_SECRET=
# Meta allows ONE callback URL per app. If another service (e.g. an OTP flow) needs
# the same events, set its URL here and verified payloads are relayed on verbatim.
META_WA_FORWARD_URL=
